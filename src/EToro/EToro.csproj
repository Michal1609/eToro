<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EToro</AssemblyName>
    <RootNamespace>EToro</RootNamespace>
    <PackageId>grznarai.etoro</PackageId>
    <Title>EToro .NET Client</Title>
    <Description>Typed .NET client library for the eToro public API.</Description>
    <PackageTags>etoro;api;client;dotnet;trading</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\nuget\MG mark.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
