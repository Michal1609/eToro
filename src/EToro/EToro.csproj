<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EToro</AssemblyName>
    <RootNamespace>EToro</RootNamespace>
    <PackageId>grznarai.etoro</PackageId>
    <Title>EToro .NET Client</Title>
    <!-- Package id (grznarai.etoro) differs from namespace (EToro) intentionally — see README for usage. -->
    <!-- Strong-naming: intentionally unsigned. Enterprise consumers requiring strong names should pin to a fork. -->
    <Description>Typed .NET client library for the eToro public API. Read-only at present. Not affiliated with eToro. No financial advice; informational/educational use only.</Description>
    <PackageTags>etoro;api;client;dotnet;trading</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\CHANGELOG.md'))</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.7" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" PrivateAssets="All" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="README.nuget.md" />
    <None Include="..\..\assets\nuget\MG mark.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
